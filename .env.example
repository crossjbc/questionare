# Copy this to .env and fill in real values. .env is gitignored.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True to use Postgres (required for the docker-compose setup and
# for pgvector). Leave False to use local sqlite for quick model/admin work.
DJANGO_USE_POSTGRES=False
POSTGRES_DB=interview_prep
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Added in Phase 2+ — not required yet
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
